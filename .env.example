# Postgres (Neon or Supabase), must support PostGIS and btree_gist.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Postmark (email) — deferred wiring, needed by Wednesday
POSTMARK_SERVER_TOKEN=""
POSTMARK_FROM_EMAIL="bookings@localli.app"

# Mapbox (geocoding, mobile module)
MAPBOX_TOKEN=""

# Inngest (background jobs)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Cloudflare Turnstile (bot protection on the public signup endpoint).
# Both must be set for it to activate; unset means it is inert.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# How many trusted proxies sit in front of the app. 0 (default) ignores
# x-forwarded-for entirely, which is correct for a directly exposed server.
# Vercel and most single-proxy setups are 1. Getting this wrong lets a client
# forge their IP and walk past the per-IP rate limit.
TRUSTED_PROXY_HOP_COUNT="0"
